# Copy to .env and fill in. The server boots without this, but /api/generate
# will return a fallback card until it is set.
OPENAI_API_KEY=sk-...

# Any model that supports structured outputs.
OPENAI_MODEL=gpt-4o-mini

# Comma-separated. Add your Vite dev URL if it is not on 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
